// Función Invertir Frase
string invfrase(string frase) {
    string fraseinv = "";

    for (int i = frase.length() - 1; i >= 0; i--) {
        fraseinv += frase[i];
    }

    return fraseinv;
}

// Función Quitar Vocales
string quitarVocal(string frase) {
    string aux = "";

    for (int i = 0; i < frase.length(); i++) {

        if (frase[i] != 'a' && frase[i] != 'e' &&
            frase[i] != 'i' && frase[i] != 'o' &&
            frase[i] != 'u' && frase[i] != 'A' &&
            frase[i] != 'E' && frase[i] != 'I' &&
            frase[i] != 'O' && frase[i] != 'U') {

            aux += frase[i];
        }
    }

    return aux;
}

// Función Intercambiar Palabras
void intercambiar(string& var1, string& var2) {
    var1.swap(var2);
}

// Función Sacar Substring
string sacarSubstring(string frase, int inicio, int cantidad) {
    return frase.substr(inicio, cantidad);
}

// Función Contar Vocales
int contarVocales(string frase) {
    int contador = 0;

    for (int i = 0; i < frase.length(); i++) {

        if (frase[i] == 'a' || frase[i] == 'e' ||
            frase[i] == 'i' || frase[i] == 'o' ||
            frase[i] == 'u' || frase[i] == 'A' ||
            frase[i] == 'E' || frase[i] == 'I' ||
            frase[i] == 'O' || frase[i] == 'U') {

            contador++;
        }
    }

    return contador;
}

// Función Quitar Espacios
string quitarEspacios(string frase) {
    string aux = "";

    for (int i = 0; i < frase.length(); i++) {

        if (frase[i] != ' ') {
            aux += frase[i];
        }
    }

    return aux;
}

// Función Encontrar Caracter
void encontrarCaracter(string frase, char caracter) {

    bool encontrado = false;

    for (int i = 0; i < frase.length(); i++) {

        if (frase[i] == caracter) {
            cout << "Caracter encontrado en la posicion: "
                 << i << endl;

            encontrado = true;
        }
    }

    if (!encontrado) {
        cout << "Caracter no encontrado." << endl;
    }
}

// Función Longitud
int longitudFrase(string frase) {
    return frase.length();
}

// Función Comparar Frases
void compararFrases(string frase1, string frase2) {

    if (frase1 == frase2) {
        cout << "Las frases son iguales." << endl;
    }
    else {
        cout << "Las frases son diferentes." << endl;
    }
}
