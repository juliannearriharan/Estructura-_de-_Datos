#include <iostream>

using namespace std;

#define MAX 100

using TipoDato = int;

/*************************************************************/
/*                         CLASE PILA                        */
/*************************************************************/
class Pila
{
private:
    int pila[MAX];
    int cima;

public:
    Pila();

    bool Apilar(TipoDato& elemento);
    bool Desapilar();

    bool CimaPila(TipoDato& elemento);

    void LimpiarPila();

    void VerPila();

    bool PilaVacia();

    bool Iguales(Pila p);
};

/*************************************************************/
/*                    IMPLEMENTACION                         */
/*************************************************************/

// Constructor
Pila::Pila()
{
    cima = -1;
}

// Apilar elemento
bool Pila::Apilar(TipoDato& elemento)
{
    bool res;

    if (cima == MAX - 1)
    {
        cout << "Desbordamiento de pila (Overflow)" << endl;
        res = false;
    }
    else
    {
        cima++;
        pila[cima] = elemento;
        res = true;
    }

    return res;
}

// Desapilar elemento
bool Pila::Desapilar()
{
    bool res;

    if (cima == -1)
    {
        cerr << "No se puede desapilar. Pila vacia (Underflow)" << endl;
        res = false;
    }
    else
    {
        cima--;
        res = true;
    }

    return res;
}

// Mostrar elemento de la cima
bool Pila::CimaPila(TipoDato& elemento)
{
    bool res;

    if (PilaVacia())
    {
        cerr << "La pila esta vacia" << endl;
        res = false;
    }
    else
    {
        elemento = pila[cima];
        res = true;
    }

    return res;
}

// Mostrar todos los elementos
void Pila::VerPila()
{
    if (PilaVacia())
    {
        cout << "La pila esta vacia" << endl;
    }
    else
    {
        cout << "\nElementos de la pila:\n";

        for (int i = cima; i >= 0; i--)
        {
            cout << pila[i] << endl;
        }
    }
}

// Verificar si la pila esta vacia
bool Pila::PilaVacia()
{
    return cima == -1;
}

// Limpiar pila
void Pila::LimpiarPila()
{
    cima = -1;

    cout << "La pila fue limpiada correctamente" << endl;
}

// Comparar dos pilas
bool Pila::Iguales(Pila p)
{
    // Verifica tamaño
    if (cima != p.cima)
        return false;

    // Compara elemento por elemento
    for (int i = 0; i <= cima; i++)
    {
        if (pila[i] != p.pila[i])
            return false;
    }

    return true;
}

/*************************************************************/
/*                           MAIN                            */
/*************************************************************/

int main()
{
    int opcion;
    int r;
    int x;

    Pila p1, p2;

    do
    {
        cout << "\n===================================" << endl;
        cout << "          MENU DE PILA             " << endl;
        cout << "===================================" << endl;

        cout << "1.- Apilar (Push)" << endl;
        cout << "2.- Desapilar (Pop)" << endl;
        cout << "3.- Ver elemento de la cima" << endl;
        cout << "4.- Verificar si esta vacia" << endl;
        cout << "5.- Comparar pilas" << endl;
        cout << "6.- Ver pila" << endl;
        cout << "7.- Limpiar pila" << endl;
        cout << "0.- Salir" << endl;

        cout << "\nElige una opcion: ";
        cin >> opcion;

        switch (opcion)
        {

        case 1:

            cout << "Ingrese dato para apilar: ";
            cin >> r;

            if (p1.Apilar(r))
                cout << "Dato apilado correctamente" << endl;

            break;

        case 2:

            if (p1.Desapilar())
                cout << "Elemento desapilado correctamente" << endl;

            break;

        case 3:

            if (p1.CimaPila(r))
                cout << "El elemento en la cima es: " << r << endl;

            break;

        case 4:

            if (p1.PilaVacia())
                cout << "La pila esta vacia" << endl;
            else
                cout << "La pila NO esta vacia" << endl;

            break;

        case 5:

            cout << "Ingrese un elemento para la segunda pila: ";
            cin >> x;

            p2.Apilar(x);

            if (p1.Iguales(p2))
                cout << "Las pilas son iguales" << endl;
            else
                cout << "Las pilas NO son iguales" << endl;

            break;

        case 6:

            p1.VerPila();

            break;

        case 7:

            p1.LimpiarPila();

            break;

        case 0:

            cout << "Saliendo del programa..." << endl;

            break;

        default:

            cout << "Opcion invalida" << endl;
        }

    } while (opcion != 0);

    return 0;
}
